      <button class="persona-btn" id="btn-car" onclick="setPersona('CAR')">Cybercab / AV</button>
      <button class="persona-btn" id="btn-drone" onclick="setPersona('DRONE')">Delivery Drone</button>
    </div>

    <div class="clamp-alert" id="clamp-status">STATUS: NOMINAL / SAFE INVARIANT PRESERVED</div>
  </div>

  <!-- Telemetry HUD -->
  <div class="hud-panel" id="telemetry-panel">
    <div class="subtitle" style="margin-bottom: 4px;">SYSTEM TELEMETRY</div>
    <div class="metric-row"><span class="metric-label" id="lbl-tick">500 Hz Kernel Tick</span><span class="metric-val" id="val-tick">0</span></div>
    <div class="metric-row"><span class="metric-label" id="lbl-kinematic">Joint 5 Applied Torque</span><span class="metric-val" id="val-kinematic">0.00 Nm</span></div>
    <div class="metric-row"><span class="metric-label" id="lbl-pos">Joint 5 Position</span><span class="metric-val" id="val-pos">0.000 rad</span></div>
    <div class="metric-row"><span class="metric-label" id="lbl-margin">Safety Barrier Clearance</span><span class="metric-val" id="val-margin">0.000 m</span></div>
    <div class="metric-row"><span class="metric-label" id="lbl-stress">Peak Structural Stress</span><span class="metric-val" id="val-stress">0.0 MPa</span></div>
    <div class="metric-row"><span class="metric-label">Peak Temperature</span><span class="metric-val" id="val-temp">0.0 °C</span></div>
    <div class="metric-row"><span class="metric-label">FNO Physics Latency</span><span class="metric-val" id="val-fno">0.00 ms</span></div>
  </div>

  <!-- Active CBF Tuning -->
  <div class="hud-panel" id="tuning-panel">
    <div class="subtitle" style="margin-bottom: 4px;">ACTIVE CBF CONSTRAINT TUNING</div>
    
    <div class="slider-container">
      <div class="slider-header">
        <span id="lbl-slider-margin">Obstacle Bubble Margin:</span>
        <span id="slider-margin-val" style="color: #0284c7; font-weight:700;">0.08 m</span>
      </div>
      <input type="range" id="input-margin" min="0.02" max="0.25" step="0.01" value="0.08" oninput="onTuningChange()">
    </div>

    <div class="slider-container" style="margin-top: 10px;">
      <div class="slider-header">
        <span>Barrier Stiffness (Gamma):</span>
        <span id="slider-gamma-val" style="color: #0284c7; font-weight:700;">15.0</span>
      </div>
      <input type="range" id="input-gamma" min="5.0" max="40.0" step="1.0" value="15.0" oninput="onTuningChange()">
    </div>
  </div>

  <!-- Stress Test Panel -->
  <div class="hud-panel" id="control-panel">
    <div class="subtitle" style="margin-bottom: 4px;">PHYSICAL INVARIANT STRESS TEST</div>
    <p style="font-size: 11px; color: #64748b; line-height: 14px;" id="lbl-scenario-desc">
      Inject an intentional torque spike (+45 Nm) commanding the manipulator directly into the obstacle zone to observe real-time CBF active-set clamping.
    </p>
    <div class="btn-row">
      <button class="action hazard" id="btn-hazard" onclick="triggerHazard()">DISPATCH HAZARD (+45 Nm)</button>
      <button class="action" onclick="triggerReset()">HOLD / ZERO TORQUE</button>
    </div>
  </div>

  <!-- RocksDB Replay Scrubber -->
  <div class="hud-panel" id="replay-panel">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <span class="subtitle" style="margin: 0;">ROCKSDB TIME-TRAVEL BLACK-BOX (cf_cbf_interventions)</span>
      <span class="replay-badge" id="replay-status">LIVE STREAMING</span>
    </div>
    
    <div class="replay-controls">
      <button class="action" style="width: 25%; padding: 6px;" onclick="fetchIncidents()">SYNC ROCKSDB</button>
      <select class="incident-select" id="incident-dropdown" onchange="onSelectIncident()">
        <option value="">-- Select Recorded Incident --</option>
      </select>
      <button class="action" style="width: 20%; padding: 6px;" onclick="resumeLive()">RESUME LIVE</button>
    </div>

    <div class="slider-container">
      <input type="range" id="replay-scrubber" min="0" max="100" value="100" oninput="onScrub(this.value)">
    </div>
  </div>

  <script>
    let isLive = true;
    let incidents = [];
    let currentPersona = 'ARM';
    let currentMargin = 0.08;

    // 1. Studio Daylight Scene Setup
    const container = document.getElementById('canvas-container');
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xf1f5f9);

    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
    camera.position.set(2.6, 2.2, 3.0);

    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    container.appendChild(renderer.domElement);

    const controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.target.set(0, 0.5, 0);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.update();

    // Studio Illumination
    scene.add(new THREE.HemisphereLight(0xffffff, 0xe2e8f0, 0.85));

    const keyLight = new THREE.DirectionalLight(0xffffff, 0.95);
    keyLight.position.set(6, 14, 8);
    keyLight.castShadow = true;
    keyLight.shadow.mapSize.width = 2048;
    keyLight.shadow.mapSize.height = 2048;
    keyLight.shadow.bias = -0.0005;
    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(0xbae6fd, 0.4);
    fillLight.position.set(-6, 6, -6);
    scene.add(fillLight);

    // Factory Studio Floor
    const floorMesh = new THREE.Mesh(
      new THREE.PlaneGeometry(30, 30),
      new THREE.MeshStandardMaterial({ color: 0xf8fafc, roughness: 0.8, metalness: 0.1 })
    );
    floorMesh.rotation.x = -Math.PI / 2;
    floorMesh.receiveShadow = true;
    scene.add(floorMesh);

    const grid = new THREE.GridHelper(12, 48, 0x94a3b8, 0xe2e8f0);
    grid.position.y = 0.002;
    scene.add(grid);

    // =========================================================================
    // MODEL 1: 7-DOF Robotic Arm (Franka / KUKA Style)
    // =========================================================================
    const armGroup = new THREE.Group();
    const joints = [];
    const links = [];
    const linkLengths = [0.35, 0.40, 0.35, 0.35, 0.25, 0.20, 0.15];

    // Heavy Base Pedestal
    const pedestal = new THREE.Group();
    const basePlate = new THREE.Mesh(
      new THREE.CylinderGeometry(0.24, 0.28, 0.06, 32),
      new THREE.MeshStandardMaterial({ color: 0x334155, metalness: 0.8, roughness: 0.3 })
    );
    basePlate.position.y = 0.03;
    basePlate.castShadow = true;
    pedestal.add(basePlate);

    const baseRiser = new THREE.Mesh(
      new THREE.CylinderGeometry(0.16, 0.20, 0.12, 32),
      new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.6, roughness: 0.4 })
    );
    baseRiser.position.y = 0.12;
    baseRiser.castShadow = true;
    pedestal.add(baseRiser);

    const statusRing = new THREE.Mesh(
      new THREE.TorusGeometry(0.165, 0.012, 16, 48),
      new THREE.MeshBasicMaterial({ color: 0x0284c7 })
    );
    statusRing.rotation.x = Math.PI / 2;
    statusRing.position.y = 0.18;
    pedestal.add(statusRing);
    armGroup.add(pedestal);

    let parentObj = armGroup;
    for (let i = 0; i < 7; i++) {
      const jointGroup = new THREE.Group();
      if (i === 0) jointGroup.position.set(0, 0.20, 0);
      else jointGroup.position.set(0, linkLengths[i - 1], 0);

      const motorHousing = new THREE.Mesh(
        new THREE.CylinderGeometry(0.08, 0.08, 0.11, 24),
        new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.85, roughness: 0.25 })
      );
      motorHousing.rotation.z = Math.PI / 2;
      motorHousing.castShadow = true;
      jointGroup.add(motorHousing);

      const linkGeom = new THREE.CylinderGeometry(0.045, 0.065, linkLengths[i], 24);
      const linkMat = new THREE.MeshStandardMaterial({
        color: 0x0284c7, metalness: 0.5, roughness: 0.35
      });
      const linkMesh = new THREE.Mesh(linkGeom, linkMat);
      linkMesh.position.set(0, linkLengths[i] / 2, 0);
      linkMesh.castShadow = true;
      jointGroup.add(linkMesh);

      parentObj.add(jointGroup);
      parentObj = jointGroup;
      joints.push(jointGroup);
      links.push(linkMesh);
    }

    // Parallel Gripper End-Effector
    const wristGroup = joints[6];
    const gripperBase = new THREE.Mesh(
      new THREE.BoxGeometry(0.12, 0.04, 0.08),
      new THREE.MeshStandardMaterial({ color: 0x0f172a, metalness: 0.8 })
    );
    gripperBase.position.y = 0.17;
    wristGroup.add(gripperBase);

    const fingerGeom = new THREE.BoxGeometry(0.02, 0.08, 0.025);
    const fingerMat = new THREE.MeshStandardMaterial({ color: 0xd97706, roughness: 0.4 });
    const fingerLeft = new THREE.Mesh(fingerGeom, fingerMat);
    fingerLeft.position.set(-0.04, 0.22, 0);
    wristGroup.add(fingerLeft);
    const fingerRight = new THREE.Mesh(fingerGeom, fingerMat);
    fingerRight.position.set(0.04, 0.22, 0);
    wristGroup.add(fingerRight);

    scene.add(armGroup);

    // =========================================================================
    // MODEL 2: Realistic Cybercab / Autonomous Vehicle (Integrated Coupe)
    // =========================================================================
    const carGroup = new THREE.Group();
    carGroup.visible = false;

    // Body Paint & Glass Materials
    const carPaint = new THREE.MeshStandardMaterial({
      color: 0x334155, metalness: 0.85, roughness: 0.25
    });
    const glassMat = new THREE.MeshStandardMaterial({
      color: 0x0f172a, metalness: 0.9, roughness: 0.1, transparent: true, opacity: 0.85
    });

    // 1. Lower Chassis & Side Skirts
    const lowerBody = new THREE.Mesh(new THREE.BoxGeometry(0.96, 0.18, 2.2), carPaint);
    lowerBody.position.set(0, 0.18, 0);
    lowerBody.castShadow = true;
    carGroup.add(lowerBody);

    // 2. Aerodynamic Sloped Front Hood
    const hood = new THREE.Mesh(new THREE.BoxGeometry(0.92, 0.12, 0.65), carPaint);
    hood.rotation.x = 0.12;
    hood.position.set(0, 0.28, 0.70);
    hood.castShadow = true;
    carGroup.add(hood);

    // 3. Sloped Windshield (Seamlessly connected to hood and roof)
    const windshield = new THREE.Mesh(new THREE.BoxGeometry(0.86, 0.03, 0.60), glassMat);
    windshield.rotation.x = -0.68;
    windshield.position.set(0, 0.44, 0.24);
    carGroup.add(windshield);

    // 4. Tinted Panoramic Glass Roof
    const roof = new THREE.Mesh(new THREE.BoxGeometry(0.84, 0.05, 0.65), glassMat);
    roof.position.set(0, 0.58, -0.22);
    roof.castShadow = true;
    carGroup.add(roof);

    // 5. Fastback Rear Hatch Window
    const rearGlass = new THREE.Mesh(new THREE.BoxGeometry(0.84, 0.03, 0.65), glassMat);
    rearGlass.rotation.x = 0.52;
    rearGlass.position.set(0, 0.45, -0.72);
    carGroup.add(rearGlass);

    // 6. Rear Trunk & Integrated Spoiler Deck
    const trunkDeck = new THREE.Mesh(new THREE.BoxGeometry(0.92, 0.14, 0.35), carPaint);
    trunkDeck.position.set(0, 0.30, -0.98);
    trunkDeck.castShadow = true;
    carGroup.add(trunkDeck);

    // 7. Front Edge-to-Edge Cyan Lightblade
    const frontLight = new THREE.Mesh(
      new THREE.BoxGeometry(0.90, 0.04, 0.04),
      new THREE.MeshBasicMaterial({ color: 0x38bdf8 })
    );
    frontLight.position.set(0, 0.22, 1.10);
    carGroup.add(frontLight);

    // 8. Rear Edge-to-Edge Red Taillight
    const rearLight = new THREE.Mesh(
      new THREE.BoxGeometry(0.90, 0.04, 0.04),
      new THREE.MeshBasicMaterial({ color: 0xef4444 })
    );
    rearLight.position.set(0, 0.30, -1.10);
    carGroup.add(rearLight);

    // 9. Roof-Mounted Solid-State LiDAR Sensor (Sitting Flush on Roof)
    const roofBase = new THREE.Mesh(
      new THREE.CylinderGeometry(0.08, 0.10, 0.04, 24),
      new THREE.MeshStandardMaterial({ color: 0x0f172a, metalness: 0.9 })
    );
    roofBase.position.set(0, 0.62, -0.20);
    carGroup.add(roofBase);

    const lidarPod = new THREE.Group();
    lidarPod.position.set(0, 0.65, -0.20);
    const lidarCyl = new THREE.Mesh(
      new THREE.CylinderGeometry(0.06, 0.06, 0.04, 16),
      new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.3 })
    );
    lidarPod.add(lidarCyl);
    const lidarLens = new THREE.Mesh(
      new THREE.BoxGeometry(0.11, 0.02, 0.03),
      new THREE.MeshBasicMaterial({ color: 0x38bdf8 })
    );
    lidarPod.add(lidarLens);
    carGroup.add(lidarPod);

    // Detailed Wheels & Steering Knuckles
    function createWheel() {
      const wheel = new THREE.Group();
      const tire = new THREE.Mesh(
        new THREE.CylinderGeometry(0.18, 0.18, 0.11, 24),
        new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.9 })
      );
      tire.rotation.z = Math.PI / 2;
      tire.castShadow = true;
      wheel.add(tire);

      const rim = new THREE.Mesh(
        new THREE.CylinderGeometry(0.12, 0.12, 0.112, 16),
        new THREE.MeshStandardMaterial({ color: 0x94a3b8, metalness: 0.9, roughness: 0.2 })
      );
      rim.rotation.z = Math.PI / 2;
      wheel.add(rim);

      const caliper = new THREE.Mesh(
        new THREE.BoxGeometry(0.03, 0.06, 0.04),
        new THREE.MeshStandardMaterial({ color: 0xdc2626 })
      );
      caliper.position.set(0.04, 0.06, 0);
      wheel.add(caliper);
      return wheel;
    }

    const frontLeftKnuckle = new THREE.Group();
    frontLeftKnuckle.position.set(0.53, 0.18, 0.65);
    frontLeftKnuckle.add(createWheel());
    carGroup.add(frontLeftKnuckle);

    const frontRightKnuckle = new THREE.Group();
    frontRightKnuckle.position.set(-0.53, 0.18, 0.65);
    const frW = createWheel();
    frW.rotation.y = Math.PI;
    frontRightKnuckle.add(frW);
    carGroup.add(frontRightKnuckle);

    const rearLeft = createWheel();
    rearLeft.position.set(0.53, 0.18, -0.65);
    carGroup.add(rearLeft);

    const rearRight = createWheel();
    rearRight.position.set(-0.53, 0.18, -0.65);
    rearRight.rotation.y = Math.PI;
    carGroup.add(rearRight);

    scene.add(carGroup);

    // =========================================================================
    // MODEL 3: Delivery Drone
    // =========================================================================
    const droneGroup = new THREE.Group();
    droneGroup.visible = false;
    droneGroup.position.set(0, 1.35, 0);

    const fuselageGeom = new THREE.SphereGeometry(0.24, 32, 16);
    fuselageGeom.scale(1.2, 0.55, 1.6);
    const fuselage = new THREE.Mesh(
      fuselageGeom,
      new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.85, roughness: 0.3 })
    );
    fuselage.castShadow = true;
    droneGroup.add(fuselage);

    const deliveryCargo = new THREE.Mesh(
      new THREE.BoxGeometry(0.28, 0.22, 0.34),
      new THREE.MeshStandardMaterial({ color: 0xd97706, roughness: 0.45 })
    );
    deliveryCargo.position.set(0, -0.24, 0);
    deliveryCargo.castShadow = true;
    droneGroup.add(deliveryCargo);

    const rotorBlades = [];
    const boomAngles = [Math.PI / 4, 3 * Math.PI / 4, 5 * Math.PI / 4, 7 * Math.PI / 4];
    const armRadius = 0.50;

    boomAngles.forEach((angle) => {
      const boom = new THREE.Mesh(
        new THREE.CylinderGeometry(0.02, 0.024, armRadius, 12),
        new THREE.MeshStandardMaterial({ color: 0x0f172a, metalness: 0.8 })
      );
      boom.position.set(Math.cos(angle) * (armRadius / 2), 0.02, Math.sin(angle) * (armRadius / 2));
      boom.rotation.z = Math.PI / 2;
      boom.rotation.y = -angle;
      droneGroup.add(boom);

      const motor = new THREE.Mesh(
        new THREE.CylinderGeometry(0.045, 0.045, 0.07, 16),
        new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.9 })
      );
      motor.position.set(Math.cos(angle) * armRadius, 0.06, Math.sin(angle) * armRadius);
      droneGroup.add(motor);

      const propGroup = new THREE.Group();
      propGroup.position.set(Math.cos(angle) * armRadius, 0.10, Math.sin(angle) * armRadius);
      const blade = new THREE.Mesh(
        new THREE.BoxGeometry(0.38, 0.006, 0.032),
        new THREE.MeshStandardMaterial({ color: 0x0284c7, transparent: true, opacity: 0.8 })
      );
      propGroup.add(blade);
      droneGroup.add(propGroup);
      rotorBlades.push(propGroup);
    });

    scene.add(droneGroup);

    // =========================================================================
    // Dynamic Obstacle & High-Visibility CBF Barrier Forcefield
    // =========================================================================
    const obsMesh = new THREE.Mesh(
      new THREE.SphereGeometry(0.08, 32, 32),
      new THREE.MeshStandardMaterial({ color: 0xdc2626, metalness: 0.4, roughness: 0.3 })
    );
    obsMesh.castShadow = true;
    scene.add(obsMesh);

    let bubbleMesh = new THREE.Mesh(
      new THREE.SphereGeometry(0.16, 32, 32),
      new THREE.MeshBasicMaterial({ color: 0xdc2626, wireframe: true, transparent: true, opacity: 0.45 })
    );
    scene.add(bubbleMesh);

    function updateObstaclePosition(persona) {
      if (persona === 'CAR') {
        obsMesh.position.set(0.0, 0.22, 2.1);
      } else if (persona === 'DRONE') {
        obsMesh.position.set(0.8, 1.4, 0.8);
      } else {
        obsMesh.position.set(0.50, 0.45, 0.30);
      }
      bubbleMesh.position.copy(obsMesh.position);
    }
    updateObstaclePosition('ARM');

    // =========================================================================
    // WebSocket Telemetry Ingestion
    // =========================================================================
    const ws = new WebSocket(`ws://${window.location.host}/ws/telemetry`);
    ws.onmessage = (event) => {
      if (!isLive) return;
      const data = JSON.parse(event.data);

      if (currentPersona === 'ARM') {
        for (let i = 0; i < 7; i++) {
          if (i % 2 === 0) joints[i].rotation.y = data.positions[i];
          else joints[i].rotation.z = data.positions[i];

          const stressRatio = Math.min(data.stresses[i] / 80.0, 1.0);
          links[i].material.color.setHSL(0.55 - (stressRatio * 0.55), 0.9, 0.45);
        }
      } else if (currentPersona === 'CAR') {
        const steerAngle = (data.positions[5] - 2.80) * 1.5;
        frontLeftKnuckle.rotation.y = steerAngle;
        frontRightKnuckle.rotation.y = steerAngle;
        carGroup.rotation.y = steerAngle * 0.25;
        carGroup.position.x = -steerAngle * 0.35;
      } else if (currentPersona === 'DRONE') {
        droneGroup.rotation.z = (data.positions[5] - 2.80) * 0.6;
        droneGroup.rotation.x = data.positions[4] * 0.3;
        droneGroup.position.y = 1.35 + (data.torques[5] * 0.005);
      }

      document.getElementById('val-tick').innerText = data.sequence.toLocaleString();
      document.getElementById('val-pos').innerText = `${data.positions[5].toFixed(3)} rad`;
      document.getElementById('val-kinematic').innerText = `${data.torques[5].toFixed(2)} Nm`;
      document.getElementById('val-margin').innerText = `${data.barrier_margin.toFixed(3)} m`;
      document.getElementById('val-stress').innerText = `${data.max_stress.toFixed(1)} MPa`;
      document.getElementById('val-temp').innerText = `${data.max_temp.toFixed(1)} °C`;
      document.getElementById('val-fno').innerText = `${data.fno_eval_ms} ms`;

      const clampEl = document.getElementById('clamp-status');
      if (data.watchdog_tripped) {
        clampEl.innerText = "FAIL-SAFE ENGAGED: UPSTREAM HEARTBEAT TIMEOUT";
        clampEl.className = "clamp-alert watchdog";
      } else if (data.clamped) {
        clampEl.innerText = "WARNING: CBF ACTIVE — TORQUE OVERRIDDEN";
        clampEl.className = "clamp-alert active";
      } else {
        clampEl.innerText = "STATUS: NOMINAL / SAFE INVARIANT PRESERVED";
        clampEl.className = "clamp-alert";
      }
    };

    // =========================================================================
    // Persona Switcher
    // =========================================================================
    function setPersona(persona) {
      currentPersona = persona;
      document.getElementById('btn-arm').className = `persona-btn ${persona === 'ARM' ? 'active' : ''}`;
      document.getElementById('btn-car').className = `persona-btn ${persona === 'CAR' ? 'active' : ''}`;
      document.getElementById('btn-drone').className = `persona-btn ${persona === 'DRONE' ? 'active' : ''}`;

      armGroup.visible = (persona === 'ARM');
      carGroup.visible = (persona === 'CAR');
      droneGroup.visible = (persona === 'DRONE');

      updateObstaclePosition(persona);

      if (persona === 'CAR') {
        camera.position.set(0.0, 2.0, 3.6);
        controls.target.set(0.0, 0.4, 0.8);
        document.getElementById('lbl-kinematic').innerText = "Steering Drive Torque";
        document.getElementById('lbl-pos').innerText = "Front Wheel Steering Angle";
        document.getElementById('lbl-margin').innerText = "Time-To-Collision Buffer";
        document.getElementById('lbl-stress').innerText = "Tire Friction Circle Load";
        document.getElementById('lbl-slider-margin').innerText = "Forward Braking Margin:";
        document.getElementById('lbl-scenario-desc').innerText = "Simulate Cybercab vision occlusion: foundation model commands full throttle (+45 Nm) straight toward a stopped vehicle; C++ Drive-by-Wire CBF halts vehicle 3mm before impact.";
        document.getElementById('btn-hazard').innerText = "DISPATCH HAZARD (BRAKE TEST)";
      } else if (persona === 'DRONE') {
        camera.position.set(2.4, 2.2, 2.4);
        controls.target.set(0.0, 1.35, 0.0);
        document.getElementById('lbl-kinematic').innerText = "Rotor Thrust Differential";
        document.getElementById('lbl-pos').innerText = "Pitch / Roll Tilt Angle";
        document.getElementById('lbl-margin').innerText = "3D Airspace Geofence Margin";
        document.getElementById('lbl-stress').innerText = "Stator Coil Joule Heating";
        document.getElementById('lbl-slider-margin').innerText = "Geofence Safe Bubble:";
        document.getElementById('lbl-scenario-desc').innerText = "Simulate extreme wind turbulence: policy commands aggressive pitch toward an obstacle; C++ kernel overrides thrust to maintain strict 3D keep-out sphere.";
        document.getElementById('btn-hazard').innerText = "DISPATCH HAZARD (WIND GUST)";
      } else {
        camera.position.set(2.6, 2.2, 3.0);
        controls.target.set(0.0, 0.6, 0.0);
        document.getElementById('lbl-kinematic').innerText = "Joint 5 Applied Torque";
        document.getElementById('lbl-pos').innerText = "Joint 5 Position";
        document.getElementById('lbl-margin').innerText = "Safety Barrier Clearance";
        document.getElementById('lbl-stress').innerText = "Peak Structural Stress";
        document.getElementById('lbl-slider-margin').innerText = "Obstacle Bubble Margin:";
        document.getElementById('lbl-scenario-desc').innerText = "Inject an intentional torque spike (+45 Nm) commanding the manipulator directly into the obstacle zone to observe real-time CBF active-set clamping.";
        document.getElementById('btn-hazard').innerText = "DISPATCH HAZARD (+45 Nm)";
      }
      controls.update();
    }

    // =========================================================================
    // RocksDB Replay Logic
    // =========================================================================
    async function fetchIncidents() {
      const res = await fetch('/api/v1/incidents');
      incidents = await res.json();
      const dropdown = document.getElementById('incident-dropdown');
      dropdown.innerHTML = '<option value="">-- Select Recorded Incident --</option>';
      
      incidents.forEach((inc, idx) => {
        const opt = document.createElement('option');
        opt.value = idx;
        opt.innerText = `Tick ${inc.sequence} | Cmd: ${inc.commanded_torque.toFixed(1)} Nm -> Safe: ${inc.safe_torque.toFixed(2)} Nm`;
        dropdown.appendChild(opt);
      });

      if (incidents.length > 0) {
        document.getElementById('replay-status').innerText = `SYNCD (${incidents.length} EVENTS)`;
        document.getElementById('replay-status').style.background = "#e2e8f0";
        document.getElementById('replay-status').style.color = "#0369a1";
      }
    }

    function onSelectIncident() {
      const idx = document.getElementById('incident-dropdown').value;
      if (idx === "") return;
      isLive = false;
      document.getElementById('replay-status').innerText = "PAUSED (REPLAY MODE)";
      document.getElementById('replay-status').style.background = "#fed7aa";
      document.getElementById('replay-status').style.color = "#9a3412";

      const inc = incidents[idx];
      if (currentPersona === 'ARM') {
        joints[5].rotation.z = 2.893;
        links[5].material.color.setHex(0xdc2626);
      } else if (currentPersona === 'CAR') {
        frontLeftKnuckle.rotation.y = 0.45;
        frontRightKnuckle.rotation.y = 0.45;
      }

      document.getElementById('val-tick').innerText = inc.sequence.toLocaleString();
      document.getElementById('val-kinematic').innerText = `${inc.safe_torque.toFixed(2)} Nm`;
      document.getElementById('val-margin').innerText = `${inc.barrier_margin.toFixed(3)} m`;
      
      const clampEl = document.getElementById('clamp-status');
      clampEl.innerText = `REPLAY: CBF CLAMPED COMMAND ${inc.commanded_torque.toFixed(1)} Nm TO ${inc.safe_torque.toFixed(2)} Nm`;
      clampEl.className = "clamp-alert active";
    }

    function resumeLive() {
      isLive = true;
      document.getElementById('replay-status').innerText = "LIVE STREAMING";
      document.getElementById('replay-status').style.background = "#e2e8f0";
      document.getElementById('replay-status').style.color = "#0369a1";
      document.getElementById('incident-dropdown').value = "";
    }

    function onScrub(val) {
      if (incidents.length === 0) return;
      const idx = Math.floor((val / 100) * (incidents.length - 1));
      document.getElementById('incident-dropdown').value = idx;
      onSelectIncident();
    }

    function onTuningChange() {
      const margin = parseFloat(document.getElementById('input-margin').value);
      const gamma = parseFloat(document.getElementById('input-gamma').value);
      currentMargin = margin;

      document.getElementById('slider-margin-val').innerText = `${margin.toFixed(2)} m`;
      document.getElementById('slider-gamma-val').innerText = `${gamma.toFixed(1)}`;

      scene.remove(bubbleMesh);
      bubbleMesh = new THREE.Mesh(
        new THREE.SphereGeometry(0.08 + margin, 32, 32),
        new THREE.MeshBasicMaterial({ color: 0xdc2626, wireframe: true, transparent: true, opacity: 0.45 })
      );
      bubbleMesh.position.copy(obsMesh.position);
      scene.add(bubbleMesh);

      fetch('/api/v1/tuning/barrier', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ safety_margin: margin, gamma: gamma })
      });
    }

    function triggerHazard() { fetch('/api/v1/actuate/hazard', { method: 'POST' }); }
    function triggerReset() { fetch('/api/v1/actuate/reset', { method: 'POST' }); }

    // Continuous Render Loop
    function animate() {
      requestAnimationFrame(animate);

      lidarPod.rotation.y += 0.08;
      rotorBlades.forEach((prop, idx) => {
        prop.rotation.y += (idx % 2 === 0 ? 0.50 : -0.50);
      });

      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
</html>
